{
  "name": "everything-agent",
  "version": "0.1.0",
  "description": "具有透明执行过程的个人助理 Agent",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./engine": {
      "types": "./src/engine/src/index.ts",
      "default": "./src/engine/src/index.ts"
    },
    "./agent": {
      "types": "./src/agent-loop/agent-loop.ts",
      "default": "./src/agent-loop/agent-loop.ts"
    },
    "./agent-loop": {
      "types": "./src/agent-loop/agent-loop.ts",
      "default": "./src/agent-loop/agent-loop.ts"
    },
    "./agent-graph": {
      "types": "./src/agent-graph/harness-graph.ts",
      "default": "./src/agent-graph/harness-graph.ts"
    },
    "./tools": {
      "types": "./src/tools/tool-registry.ts",
      "default": "./src/tools/tool-registry.ts"
    },
    "./model": {
      "types": "./src/model/model-client.ts",
      "default": "./src/model/model-client.ts"
    }
  },
  "scripts": {
    "build": "npm run typecheck && npm run build:web",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "example": "node src/engine/examples/basic.ts"
  },
  "engines": {
    "node": ">=24.12"
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
